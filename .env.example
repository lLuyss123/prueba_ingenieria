# ====== AIRFLOW CORE ======
AIRFLOW_IMAGE_NAME=apache/airflow:3.1.5
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin_password

# Generar una con: docker run --rm apache/airflow:3.1.5 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=generate_your_fernet_key_here

# ====== AIRFLOW METADATA DB ======

AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_db_password
AIRFLOW_DB_NAME=airflow

# Debe coincidir con los datos de arriba

AIRFLOW_DB_CONN=postgresql+psycopg2://airflow:airflow_db_password@postgres/airflow

# ====== DATA WAREHOUSE (ANALYTICS) ======

DW_USER=admin_dw
DW_PASSWORD=analytics_password
DW_DB=data_warehouse